# Copy this file to .env and fill in real values. Never commit .env itself.

# Used to sign auth tokens (see src/server/utils/token.ts). Set this to a
# long random string in any real deployment.
JWT_SECRET=replace-this-with-a-long-random-string

# Port the Express server listens on.
PORT=3000

# --- Future MySQL deployment (see database/schema.sql, database/seed.sql) ---
# The app currently runs on an in-memory store shaped exactly like this
# schema. These are here for when you wire up a real mysql2 connection.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=merkato_stock
DB_USER=root
DB_PASSWORD=

# --- Telebirr (optional, for real Mobile Money integration) ---
# The app currently records TELEBIRR as a payment method without verifying
# a real transaction (see src/server/routes/sales.routes.ts). Fill these in
# only once you have real Telebirr merchant credentials.
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=

# Only needed if you use the landing page's AI-related features.
GEMINI_API_KEY=
